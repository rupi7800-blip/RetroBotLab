# RETRO BOT LAB — configurazione del server (copia in .env)

# Indirizzo e porta. Lascia 127.0.0.1 per uso locale; per l'accesso da rete usa un reverse proxy HTTPS.
HOST=127.0.0.1
PORT=8080

# Chiave per cifrare token e chiavi API salvati (stringa lunga e casuale).
# Se assente viene creata automaticamente data/.master.key.
# ATTENZIONE: se la cambi, le credenziali già salvate non saranno più leggibili.
APP_SECRET=

# Cartella dati (progetti, impostazioni, credenziali cifrate)
DATA_DIR=./data

# Controllo automatico delle fonti (ore). 0 = solo manuale.
KNOWLEDGE_UPDATE_HOURS=24

# Token GitHub in sola lettura (facoltativo): aumenta i limiti di ricerca e verifica dei repository.
# Crealo su https://github.com/settings/tokens senza alcun permesso (accesso pubblico in lettura).
GITHUB_TOKEN=

# Esecuzione dei bot nel sandbox collegato al simulatore: on | off
SANDBOX_EXEC=on
SANDBOX_MAX_SECONDS=300
SANDBOX_MAX_MEMORY_MB=512

# Indirizzo pubblico dell'app (solo se dietro reverse proxy): usato per l'URL del simulatore.
PUBLIC_URL=

SESSION_HOURS=72
HTTP_TIMEOUT_MS=20000
